# Server-only: production email requires a verified sender and working recipient.
RESEND_API_KEY=
CONTACT_FROM_EMAIL="TACTIC <enquiries@tacticforyou.com>"
CONTACT_TO_EMAIL=admin@tacticforyou.com
# Enable only after sender verification and receiving-email setup.
CONTACT_DELIVERY_ENABLED=false

# Redis: use this pair OR UPSTASH_REDIS_REST_URL/UPSTASH_REDIS_REST_TOKEN.
# The read-only token is not sufficient for rate limiting.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Public IDs, embedded at build time. GA4/Plausible are intentionally omitted.
NEXT_PUBLIC_CLARITY_PROJECT_ID=yvn7ipejec
NEXT_PUBLIC_SENTRY_DSN=

# Server/build only; never prefix the authentication token with NEXT_PUBLIC_.
SENTRY_ORG=hayyanhami
SENTRY_PROJECT=tactic
SENTRY_AUTH_TOKEN=

# Vercel supplies VERCEL_ENV and NEXT_PUBLIC_VERCEL_ENV automatically.
# Leave these unset for public production:
# CONTACT_LOCAL_RATE_LIMIT=true  (loopback testing only)
# NEXT_PUBLIC_ENABLE_TRACKING_PREVIEW=true  (explicit tracking QA only)
# NEXT_PUBLIC_ENABLE_SCENE_DEBUG=true  (scene QA only)
